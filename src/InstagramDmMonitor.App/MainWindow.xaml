<Window
    x:Class="InstagramDmMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Instagram DM Monitor">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <StackPanel Spacing="6">
            <TextBlock Text="Instagram DM Monitor" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Windows / Edge 通知プレビュー検証版" FontSize="14" Opacity="0.75" />
            <TextBlock
                Text="取得できるのはWindows通知に実際に含まれるテキストです。DMの完全な履歴を取得するものではありません。"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="プライバシー" FontWeight="SemiBold" />
                <TextBlock Text="通知リスナーの許可はWindows上の広い通知アクセス権限です。この試作版はEdge / Instagramと表示された通知候補だけを画面表示・ローカル保存します。保存先はこのアプリのローカルデータ領域です。" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button x:Name="GrantAccessButton" Content="通知アクセスを許可" Click="GrantAccessButton_Click" />
            <Button x:Name="ReadCurrentButton" Content="現在の通知を確認" Click="ReadCurrentButton_Click" />
            <Button x:Name="StartButton" Content="監視開始" Click="StartButton_Click" />
            <Button x:Name="StopButton" Content="監視停止" Click="StopButton_Click" />
            <Button x:Name="DeleteLogButton" Content="保存ログを削除" Click="DeleteLogButton_Click" />
        </StackPanel>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="6">
            <TextBlock x:Name="StatusText" Text="状態: 未接続" FontWeight="SemiBold" />
            <TextBox
                x:Name="OutputBox"
                Grid.Row="1"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                FontFamily="Consolas"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
